# Battery Property
ro.charger.enable_suspend=1
ro.recovery.usb.vid=18D1
ro.recovery.usb.adb.pid=D001
ro.recovery.usb.fastboot.pid=4EE0

# Keymaster / Keystore
persist.sys.qseelogd=true
persist.logd.size=8M

# OS Version & Security Patch (matches stock Nothing OS keymaster keyblob)
ro.build.version.release=16
ro.build.version.release_or_codename=16
ro.build.version.security_patch=2026-08-05
ro.vendor.build.security_patch=2026-08-05

