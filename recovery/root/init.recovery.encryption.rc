on property:twrp.firmware.mounted=true 
    start vendor.qseecomd

# Runs after qseecomd runs - set baseline fallback props, then start daemons.
# Note: TW_OVERRIDE_SYSTEM_PROPS in twrp.cpp and runatboot.sh dynamically override
# these props and restart KeyMint with the actual stock/custom ROM patch level.
on property:vendor.sys.listeners.registered=true
    exec u:r:su:s0 -- /system/bin/resetprop ro.build.version.release 16
    exec u:r:su:s0 -- /system/bin/resetprop ro.build.version.release_or_codename 16
    exec u:r:su:s0 -- /system/bin/resetprop ro.build.version.security_patch 2026-08-01
    exec u:r:su:s0 -- /system/bin/resetprop ro.vendor.build.security_patch 2026-04-05
    start vendor.ssgtzd
    start vendor.keymint-qti
    start vendor.gatekeeper-qti

# Runs after decryption
on property:twrp.all.users.decrypted=true
    stop keystore2
    stop vendor.gatekeeper-qti
    stop vendor.keymint-qti
    stop vendor.ssgtzd
    stop vendor.qseecomd
    setprop twrp.firmware.mounted false
    write /sys/bus/platform/devices/1d84000.ufshc/auto_hibern8 10000
    write /sys/bus/platform/devices/1d84000.ufshc/clkgate_enable 1
    write /sys/bus/platform/devices/1d84000.ufshc/enable_wb_buf_flush 1

# Runs after decryption (when user has dual apps activated/second space)
on property:twrp.decrypt.done=true && property:twrp.user.999.decrypt=0
    setprop twrp.firmware.mounted false

    write /sys/bus/platform/devices/1d84000.ufshc/auto_hibern8 10000
    write /sys/bus/platform/devices/1d84000.ufshc/clkgate_enable 1
    write /sys/bus/platform/devices/1d84000.ufshc/enable_wb_buf_flush 1

# Runs if decryption failed/was canceled
on property:of_decryption_failed=true
    setprop twrp.firmware.mounted false

    write /sys/bus/platform/devices/1d84000.ufshc/auto_hibern8 10000
    write /sys/bus/platform/devices/1d84000.ufshc/clkgate_enable 1
    write /sys/bus/platform/devices/1d84000.ufshc/enable_wb_buf_flush 1

on property:ro.twrp.fastbootd=1 && property:twrp.firmware.mounted=true
    setprop twrp.firmware.mounted false

# Keep firmware mounted for ADSP and PMIC battery/charging monitoring


